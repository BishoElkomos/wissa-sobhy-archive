{
  "name": "wissa-sobhy-tadros-archive",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://abonawessa.pages.dev/:path*",
      "permanent": true
    }
  ]
}